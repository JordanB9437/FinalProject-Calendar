public static void printMonth(String name, int[][] days) {
        int pad = (21 - name.length()) / 2;
        System.out.println(" ".repeat(pad) + name);
        System.out.println(" Su Mo Tu We Th Fr Sa");
        for (int i = 0; i < days.length; i++) {
            for (int k = 0; k < days[i].length; k++) {
                if (days[i][k] == 0) {
                    System.out.print("   ");
                } else {
                    System.out.printf("%3d", days[i][k]);
                }
            }
            System.out.println();
        }
        System.out.println();
    }

